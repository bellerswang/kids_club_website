---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, site, type Locale } from '../data/site';

interface Props { locale: Locale; }
type ProgrammeCard = {
  title: string;
  subtitle: string;
  body: string;
  image: string;
  href: string;
  alt: string;
};

const { locale } = Astro.props;
const isZh = locale === 'zh';
const copy = isZh ? {
  title: 'Sunbridge Academy｜Holiday Camp、羽毛球、吉他与 AI 课程',
  description: 'Sunbridge Academy 为学龄儿童提供 Holiday Camp、羽毛球、吉他和 AI Skills 项目。',
  heroEyebrow: 'Music · Sports · AI Skills · Holiday Camp',
  heroTitle: 'Where Every Child Shines',
  heroBody: '融合音乐、运动、AI 技能与假期营的儿童成长项目，在安全、积极的环境中帮助孩子探索兴趣、建立自信。',
  explore: '查看项目',
  contact: '联系我们',
  aboutEyebrow: '关于 Sunbridge Academy',
  aboutTitle: '让学习、运动、创造和社交更平衡',
  aboutBody: '我们面向学龄儿童提供结构清晰、体验丰富的项目。孩子可以在创意活动、体育运动、音乐学习、AI 探索和假期营中学习新技能、结交朋友并保持活力。',
  programmesEyebrow: 'Our Programmes',
  programmesTitle: '四个清晰项目',
  programmesBody: '项目文案来自当前宣传册，具体时间、费用、地点和名额请咨询确认。',
  learnMore: '查看全部项目',
  programmes: [
    {
      title: 'Holiday Camp',
      subtitle: 'Fun, Learning and Growth All in One Place',
      body: '安全、有趣且充实的学校假期项目，结合创意活动、运动、游戏和学习。',
      image: '/images/children-outdoor-play.webp',
      href: localePath(locale, 'holiday-camp'),
      alt: '孩子们在户外玩耍'
    },
    {
      title: 'Badminton',
      subtitle: 'Movement, Fitness and Confidence',
      body: '面向初学者的羽毛球课程，帮助孩子发展协调、体能、自信和运动兴趣。',
      image: '/images/children-badminton.webp',
      href: `${localePath(locale, 'programmes')}#badminton`,
      alt: '孩子们在室内学习羽毛球'
    },
    {
      title: 'Guitar',
      subtitle: 'Music, Confidence and Creative Expression',
      body: '面向儿童和青少年的初学吉他课程，通过清晰引导建立节奏、协调和音乐自信。',
      image: '/images/children-guitar.webp',
      href: `${localePath(locale, 'programmes')}#guitar`,
      alt: '孩子们参加吉他课'
    },
    {
      title: 'AI Skills',
      subtitle: 'Creativity, Logic and Digital Confidence',
      body: '通过动手项目和创意挑战，适龄认识 AI 工具、逻辑思维和数字安全。',
      image: '/images/children-ai-stem.webp',
      href: `${localePath(locale, 'programmes')}#ai-skills`,
      alt: '孩子们进行 STEM 和创意活动'
    }
  ] satisfies ProgrammeCard[],
  approachEyebrow: '我们的方式',
  approachTitle: '安全、有结构，也保留乐趣',
  approachBody: '每个项目都强调清晰引导、积极鼓励和适龄参与。孩子通过玩、练习、制作、表达和合作来学习，而不是只听讲。',
  campEyebrow: 'Main Programme',
  campTitle: 'Holiday Camp 是我们的主打假期项目',
  campBody: '学校假期期间，孩子可以在受监督的环境中体验 STEM、运动、创意工作坊、双语故事和自由活动。课程表示例已在详情页说明。',
  campButton: '了解 Holiday Camp',
  ctaTitle: '咨询适合孩子的项目',
  ctaBody: '联系我们确认当前日期、地点、时间、费用和名额。'
} : {
  title: 'Sunbridge Academy | Holiday Camp, Badminton, Guitar and AI Skills',
  description: 'Sunbridge Academy offers Holiday Camp, badminton, guitar and AI Skills programmes for school-aged children.',
  heroEyebrow: 'Music · Sports · AI Skills · Holiday Camp',
  heroTitle: 'Where Every Child Shines',
  heroBody: 'Children’s programmes across music, sports, AI skills and Holiday Camp, helping young learners explore interests and build confidence in a safe, positive environment.',
  explore: 'Explore programmes',
  contact: 'Contact us',
  aboutEyebrow: 'About Sunbridge Academy',
  aboutTitle: 'Balanced learning through activity, creativity and care',
  aboutBody: 'We provide structured, enriching programmes for school-aged children. Children can learn new skills, make friends and stay active through creative activity, sport, music, AI exploration and school holiday support.',
  programmesEyebrow: 'Our Programmes',
  programmesTitle: 'Four clear ways to take part',
  programmesBody: 'Programme descriptions are aligned with the current brochure. Contact us to confirm times, fees, locations and availability.',
  learnMore: 'Explore all programmes',
  programmes: [
    {
      title: 'Holiday Camp',
      subtitle: 'Fun, Learning and Growth All in One Place',
      body: 'Safe, fun and enriching school holiday support with creative activities, sports, games and learning.',
      image: '/images/children-outdoor-play.webp',
      href: localePath(locale, 'holiday-camp'),
      alt: 'Children playing outdoors'
    },
    {
      title: 'Badminton',
      subtitle: 'Movement, Fitness and Confidence',
      body: 'Beginner badminton coaching that builds coordination, fitness, confidence and enjoyment of sport.',
      image: '/images/children-badminton.webp',
      href: `${localePath(locale, 'programmes')}#badminton`,
      alt: 'Children learning badminton indoors'
    },
    {
      title: 'Guitar',
      subtitle: 'Music, Confidence and Creative Expression',
      body: 'Beginner-friendly guitar lessons with step-by-step guidance, rhythm, coordination and creative expression.',
      image: '/images/children-guitar.webp',
      href: `${localePath(locale, 'programmes')}#guitar`,
      alt: 'Children taking a guitar lesson'
    },
    {
      title: 'AI Skills',
      subtitle: 'Creativity, Logic and Digital Confidence',
      body: 'Age-appropriate AI exploration through guided projects, creative challenges and digital safety.',
      image: '/images/children-ai-stem.webp',
      href: `${localePath(locale, 'programmes')}#ai-skills`,
      alt: 'Children doing STEM and creative activities'
    }
  ] satisfies ProgrammeCard[],
  approachEyebrow: 'Our Approach',
  approachTitle: 'Structured, supportive and still full of joy',
  approachBody: 'Each programme combines clear guidance, positive encouragement and age-appropriate participation. Children learn by playing, practising, making, expressing themselves and working with others.',
  campEyebrow: 'Main Programme',
  campTitle: 'Holiday Camp is our main school-break offer',
  campBody: 'During selected school holidays, children can enjoy STEM discovery, sports, creative workshops, bilingual stories and supervised free play. A sample day is included on the camp page.',
  campButton: 'Explore Holiday Camp',
  ctaTitle: 'Find the right programme for your child',
  ctaBody: 'Contact us to confirm current dates, locations, times, fees and availability.'
};
---

<BaseLayout locale={locale} title={copy.title} description={copy.description}>
  <section class="hero hero-photo">
    <div class="container hero-content">
      <img src="/images/logo.svg" alt={site.name} class="hero-logo" />
      <span class="eyebrow">{copy.heroEyebrow}</span>
      <h1>{copy.heroTitle}</h1>
      <p>{copy.heroBody}</p>
      <div class="actions">
        <a class="button" href={localePath(locale, 'programmes')}>{copy.explore}</a>
        <a class="btn btn-outline" href={localePath(locale, 'contact')}>{copy.contact}</a>
      </div>
    </div>
  </section>

  <section class="section section-compact">
    <div class="container split photo-split">
      <div class="photo-mosaic reveal" aria-label={isZh ? '孩子参加活动的照片' : 'Photos of children taking part in activities'}>
        <img src="/images/children-creative-play.webp" alt="" loading="lazy" />
        <img src="/images/children-guitar.webp" alt="" loading="lazy" />
        <img src="/images/children-ai-stem.webp" alt="" loading="lazy" />
      </div>
      <div class="reveal">
        <span class="eyebrow">{copy.aboutEyebrow}</span>
        <h2>{copy.aboutTitle}</h2>
        <p>{copy.aboutBody}</p>
      </div>
    </div>
  </section>

  <section class="section section-soft" id="programmes">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">{copy.programmesEyebrow}</span>
        <h2>{copy.programmesTitle}</h2>
        <p>{copy.programmesBody}</p>
      </div>
      <div class="programme-card-grid">
        {copy.programmes.map((programme) => (
          <a class="programme-card reveal" href={programme.href}>
            <img src={programme.image} alt={programme.alt} loading="lazy" />
            <div>
              <span>{programme.title}</span>
              <h3>{programme.subtitle}</h3>
              <p>{programme.body}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="section-action">
        <a class="button" href={localePath(locale, 'programmes')}>{copy.learnMore}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">{copy.approachEyebrow}</span>
        <h2>{copy.approachTitle}</h2>
      </div>
      <div class="panel reveal"><p>{copy.approachBody}</p></div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container camp-callout reveal">
      <div>
        <span class="eyebrow">{copy.campEyebrow}</span>
        <h2>{copy.campTitle}</h2>
        <p>{copy.campBody}</p>
      </div>
      <a class="button" href={localePath(locale, 'holiday-camp')}>{copy.campButton}</a>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>{copy.ctaTitle}</h2>
      <p>{copy.ctaBody}</p>
      <a class="button" href={localePath(locale, 'contact')}>{copy.contact}</a>
    </div>
  </section>
</BaseLayout>

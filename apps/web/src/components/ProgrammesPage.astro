---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, type Locale } from '../data/site';

interface Props { locale: Locale; }
type Programme = {
  id: string;
  title: string;
  subtitle: string;
  summary: string;
  image: string;
  imageAlt: string;
  activities: string[];
  details: string;
};

const { locale } = Astro.props;
const isZh = locale === 'zh';
const copy = isZh ? {
  title: '项目 | Sunbridge Academy',
  description: '探索 Sunbridge Academy 的 Holiday Camp、羽毛球、吉他和 AI Skills 项目。',
  eyebrow: '项目',
  heading: 'Holiday Camp、羽毛球、吉他与 AI Skills',
  intro: '我们围绕宣传册中的四个核心项目组织内容。具体时间、费用、地点和名额会根据当前安排确认。',
  activity: '学习与体验内容',
  details: '适合与安排',
  programmes: [
    {
      id: 'holiday-camp',
      title: 'Holiday Camp',
      subtitle: 'Fun, Learning and Growth All in One Place',
      summary: '安全、有趣且充实的学校假期项目，结合创意活动、运动、游戏和学习，帮助孩子在假期保持活力、结交朋友并探索新兴趣。',
      image: '/images/children-outdoor-play.webp',
      imageAlt: '孩子们在户外玩耍',
      activities: ['创意活动、运动、游戏和学习', 'STEM、艺术、音乐、故事和团队活动', '受监督的自由活动与社交时间'],
      details: '面向学龄儿童。当前日期、地点、费用和名额请咨询确认。'
    },
    {
      id: 'badminton',
      title: 'Badminton',
      subtitle: 'Movement, Fitness and Confidence',
      summary: '初学者羽毛球课程通过有趣、有结构的训练，帮助孩子发展协调、体能、自信和运动兴趣。',
      image: '/images/children-badminton.webp',
      imageAlt: '孩子们在室内学习羽毛球',
      activities: ['握拍、站姿和步法基础', '发球、击球、移动和敏捷训练', '规则意识、团队合作和积极参与'],
      details: 'Beginner friendly。具体年龄组、班级人数、地点和试课安排请咨询确认。'
    },
    {
      id: 'guitar',
      title: 'Guitar',
      subtitle: 'Music, Confidence and Creative Expression',
      summary: '初学吉他项目面向刚开始接触音乐或处于早期阶段的孩子，通过循序渐进的引导建立音乐自信。',
      image: '/images/children-guitar.webp',
      imageAlt: '孩子们参加吉他课',
      activities: ['基础和弦、扫弦和节奏', '手指协调、简单歌曲和音乐模式', '音乐表达、自信和展示机会'],
      details: 'Beginner friendly。小组课和一对一安排以当前可用情况为准。'
    },
    {
      id: 'ai-skills',
      title: 'AI Skills',
      subtitle: 'Creativity, Logic and Digital Confidence',
      summary: 'AI Skills 通过有趣、动手且适龄的方式，介绍人工智能、创意科技和逻辑思维。',
      image: '/images/children-ai-stem.webp',
      imageAlt: '孩子们进行 STEM 和创意活动',
      activities: ['认识 AI 工具的基本使用方式', '逻辑思维、排序和创意问题解决', '数字安全、责任意识和简单项目展示'],
      details: '无需已有经验。设备、年龄组和班级安排请咨询确认。'
    }
  ] satisfies Programme[],
  noteTitle: '每个项目都会完全相同吗？',
  noteBody: '不会。活动、主题和安排会根据当前项目、年龄和实际情况调整。我们会在咨询时确认当前可提供的内容。',
  cta: '咨询当前项目'
} : {
  title: 'Programmes | Sunbridge Academy',
  description: 'Explore Sunbridge Academy programmes across Holiday Camp, badminton, guitar and AI Skills.',
  eyebrow: 'Programmes',
  heading: 'Holiday Camp, Badminton, Guitar and AI Skills',
  intro: 'Our public programme information now focuses on four brochure-backed offers. Times, fees, locations and availability are confirmed when you enquire.',
  activity: 'What children may learn',
  details: 'Suitable for',
  programmes: [
    {
      id: 'holiday-camp',
      title: 'Holiday Camp',
      subtitle: 'Fun, Learning and Growth All in One Place',
      summary: 'Safe, fun and enriching school holiday support with a balance of creative activities, sports, games and learning.',
      image: '/images/children-outdoor-play.webp',
      imageAlt: 'Children playing outdoors',
      activities: ['Creative activities, sports, games and learning', 'STEM, art, music, stories and teamwork tasks', 'Supervised free play and social time'],
      details: 'For school-aged children. Current dates, locations, fees and availability are confirmed when you enquire.'
    },
    {
      id: 'badminton',
      title: 'Badminton',
      subtitle: 'Movement, Fitness and Confidence',
      summary: 'Beginner badminton coaching helps children build coordination, fitness, confidence and enjoyment through fun and structured sessions.',
      image: '/images/children-badminton.webp',
      imageAlt: 'Children learning badminton indoors',
      activities: ['Grip, stance and footwork basics', 'Serving, hitting, movement and agility', 'Rules, teamwork and positive participation'],
      details: 'Beginner friendly. Current age groups, class size, venue and trial options are confirmed when you enquire.'
    },
    {
      id: 'guitar',
      title: 'Guitar',
      subtitle: 'Music, Confidence and Creative Expression',
      summary: 'Beginner guitar lessons support children and teens who are new to music or at an early stage of learning.',
      image: '/images/children-guitar.webp',
      imageAlt: 'Children taking a guitar lesson',
      activities: ['Basic chords, strumming and rhythm', 'Finger coordination, simple songs and musical patterns', 'Creative expression, confidence and performance opportunities'],
      details: 'Beginner friendly. Small group and one-to-one options depend on current availability.'
    },
    {
      id: 'ai-skills',
      title: 'AI Skills',
      subtitle: 'Creativity, Logic and Digital Confidence',
      summary: 'AI Skills introduces artificial intelligence, creative technology and logical thinking in a fun, hands-on and age-appropriate way.',
      image: '/images/children-ai-stem.webp',
      imageAlt: 'Children doing STEM and creative activities',
      activities: ['How age-appropriate AI tools work', 'Logical thinking, sequencing and creative problem-solving', 'Digital safety, responsibility and simple project sharing'],
      details: 'No prior experience needed. Devices, age groups and class arrangements are confirmed when you enquire.'
    }
  ] satisfies Programme[],
  noteTitle: 'Will every programme run in exactly the same way?',
  noteBody: 'No. Activities, themes and arrangements vary with the current programme, age group and practical details. We confirm what is currently available when you enquire.',
  cta: 'Ask about current programmes'
};
---

<BaseLayout locale={locale} title={copy.title} description={copy.description}>
  <section class="page-hero">
    <div class="container narrow reveal">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p>{copy.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container programme-list">
      {copy.programmes.map((programme, index) => (
        <article class="programme-detail programme-detail-photo reveal" id={programme.id}>
          <img src={programme.image} alt={programme.imageAlt} loading="lazy" />
          <div class="programme-copy">
            <span class="programme-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h2>{programme.title}</h2>
            <p class="lead">{programme.subtitle}</p>
            <p>{programme.summary}</p>
            <div class="programme-columns">
              <div>
                <h3>{copy.activity}</h3>
                <ul class="check-list">{programme.activities.map((item) => <li>{item}</li>)}</ul>
              </div>
              <div class="programme-support">
                <h3>{copy.details}</h3>
                <p>{programme.details}</p>
                {programme.id === 'holiday-camp' && <a class="card-link" href={localePath(locale, 'holiday-camp')}>{locale === 'zh' ? '查看 Holiday Camp 详情' : 'View Holiday Camp details'}</a>}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-soft">
    <div class="container narrow panel reveal">
      <h2>{copy.noteTitle}</h2>
      <p>{copy.noteBody}</p>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-card">
      <h2>{copy.cta}</h2>
      <a class="button" href={localePath(locale, 'contact')}>{copy.cta}</a>
    </div>
  </section>
</BaseLayout>
